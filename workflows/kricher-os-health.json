    {
      "parameters": {
        "jsCode": "const status = $input.first().json;\nconst services = status.services ?? {};\nconst problems = [];\nif (services.n8n !== true) problems.push('n8n');\nif (services.postgres !== true) problems.push('PostgreSQL');\nif (!status.host) problems.push('supervision Windows');\nif (problems.length) {\n  throw new Error(`Services indisponibles : ${problems.join(', ')}`);\n}\nreturn [{ json: {\n  state: 'healthy',\n  checkedAt: status.checkedAt,\n  version: status.version,\n  cpuLoadPercent: status.host.cpuLoadPercent,\n  memoryUsedPercent: status.host.memory.usedPercent,\n  lastBackupAt: status.host.backup?.createdAt ?? null\n} }];"
      },
